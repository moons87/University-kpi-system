# Copy this file to .env and fill in real values. Do NOT commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/university_analytics

# JWT signing key — generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Set to true when serving over HTTPS (enables Secure flag on auth cookie)
HTTPS_COOKIE=false
